Categories:
  - Connectivity
  - Social
License: MIT # [MANUAL_CONFIRMATION_REQUIRED: Confirm license alignment with maintainers in LICENSE and README.md]
AuthorName: TKMCE Student Community
SourceCode: https://github.com/creatorspara/tkmingle
IssueTracker: https://github.com/creatorspara/tkmingle/issues

AutoName: TKMingle
Summary: Campus social discovery platform for TKM College of Engineering
Description: |-
  TKMingle is a student collaboration and social discovery platform built 
  exclusively for TKM College of Engineering (TKMCE), Kollam, Kerala.

  Traditional campus life often leaves students isolated within their own 
  academic branch. TKMingle facilitates cross-departmental fellowship, campus 
  circles, and mutual-consent peer discovery.

  Features:
  * Cross-department student networking (breaking branch silos)
  * Campus Circles for IEEE, IEDC, Coding Club (FOSS), and RoboTKM
  * Real-time peer direct messaging powered by open Supabase infrastructure
  * Verified collegiate profiles

RepoType: git
Repo: https://github.com/creatorspara/tkmingle.git

Builds:
  - versionName: 1.0.0
    versionCode: 1
    # [MANUAL_CONFIRMATION_REQUIRED]: Set to the exact Git tag (e.g., v1.0.0) once created,
    # or the verified commit SHA (e.g., 29b815585063234f4d010fdff3d26a074b3c42c8).
    commit: [MANUAL_CONFIRMATION_REQUIRED - e.g. v1.0.0]
    subdir: mobile
    output: build/app/outputs/flutter-apk/app-release.apk
    flutter: yes
    # Flutter SDK version verified with the project build:
    # Flutter 3.24.5 / Dart 3.5.4
    gradle:
      - assembleRelease

AutoUpdateMode: Version
UpdateCheckMode: Tags
CurrentVersion: 1.0.0
CurrentVersionCode: 1
