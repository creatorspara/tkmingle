# ==============================================================================
# TKMingle Environment Configuration Template
# ==============================================================================
# DO NOT COMMIT SECRETS OR REAL KEYS TO VERSION CONTROL.
# Copy this file to .env.local (for Next.js web) and configure in Vercel project settings.

# --- Supabase Unified Backend (Used by Web & Mobile) ---
# Project URL found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Public anon key (Safe for browser / client exposure with Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Service role key (SERVER ONLY: Never expose to frontend or mobile client)
# Used only in Supabase Edge Functions or administrative scripts
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# --- Web Frontend & Authentication Redirects ---
NEXT_PUBLIC_SITE_URL="https://tkmingle.vercel.app"

# --- Optional Institutional Domain & Cap ---
# Default institutional domain for TKMCE students
NEXT_PUBLIC_COLLEGE_DOMAIN="tkmce.ac.in"
